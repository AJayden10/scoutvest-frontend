# URL of the Free Agent backend API (Django). Leave unset in local dev to use http://localhost:8000/api.
# On Vercel: Project Settings -> Environment Variables -> VITE_API_URL=https://your-backend.example.com/api
# With no reachable backend the app falls back to built-in sample data and says so in a banner.
VITE_API_URL=http://localhost:8000/api
